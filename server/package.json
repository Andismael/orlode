{
  "name": "corpmind-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:agents": "vitest run src/__tests__/agents/",
    "test:connectors": "vitest run src/__tests__/services/connectors/",
    "test:rag": "vitest run src/__tests__/services/rag/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@genkit-ai/firebase": "^1.31.0",
    "@genkit-ai/google-genai": "^1.16.1",
    "@google-cloud/vertexai": "^1.9.0",
    "@pinecone-database/pinecone": "^3.0.3",
    "@types/pdfkit": "^0.17.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^12.0.0",
    "genkit": "^1.16.1",
    "helmet": "^7.1.0",
    "mammoth": "^1.7.0",
    "mongodb": "^6.21.0",
    "mssql": "^11.0.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.20.0",
    "openai": "^4.29.2",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "resend": "^4.8.0",
    "rss-parser": "^3.13.0",
    "socket.io": "^4.7.4",
    "stripe": "^22.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.12.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.25",
    "@types/papaparse": "^5.3.14",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^4.1.2",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  }
}
