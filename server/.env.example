# CorpMind AI — Environment Variables
# Copy to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-in-production

# ── Firebase Admin ────────────────────────────────────────────────────────────
# Paste the full service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ── Google AI (Gemini via Genkit) — REQUIRED for agents ──────────────────────
GOOGLE_AI_API_KEY=AIza...
GOOGLE_AI_ENABLED=true

# ── Anthropic (Claude — legacy, optional) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── OpenAI (optional — legacy embedding fallback) ────────────────────────────
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# ── Pinecone (optional — legacy vector store) ────────────────────────────────
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=corpmind

# ══════════════════════════════════════════════════════════════════════════════
# MCP SERVERS — Phase 3 (Google Workspace + Slack)
# ══════════════════════════════════════════════════════════════════════════════

# ── Google Workspace MCP ──────────────────────────────────────────────────────
# Covers: Gmail, Drive, Docs, Sheets, Slides, Calendar, Tasks, Contacts
# Package: workspace-mcp (Python/PyPI — NOT npm)
# Install: pip install workspace-mcp
# Run:     uvx workspace-mcp        (requires uv: https://docs.astral.sh/uv)
#      OR: python -m workspace_mcp  (after pip install)
# GitHub:  https://github.com/taylorwilsdon/google_workspace_mcp
#
# Drive-only alternative (npm, no Gmail/Calendar):
# Run: npx -y @modelcontextprotocol/server-gdrive
#
GOOGLE_WORKSPACE_MCP_URL=http://localhost:8000/mcp
GOOGLE_WORKSPACE_MCP_TOKEN=  # OAuth2 access token (auto-refreshed by MCP server)

# OAuth credentials for the MCP server:
# GOOGLE_WORKSPACE_CLIENT_ID=<your-oauth-client-id>.apps.googleusercontent.com
# GOOGLE_WORKSPACE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_WORKSPACE_REFRESH_TOKEN=1//...

# ── Slack MCP ─────────────────────────────────────────────────────────────────
# Covers: send messages, search, upload files, user lookup
# Package: @modelcontextprotocol/server-slack (npm, archived but functional)
# PowerShell:
#   $env:SLACK_BOT_TOKEN = "xoxb-..."
#   npx -y @modelcontextprotocol/server-slack
# GitHub: https://github.com/modelcontextprotocol/servers-archived/tree/main/src/slack
#
SLACK_MCP_URL=http://localhost:8001/mcp
SLACK_BOT_TOKEN=xoxb-...          # Bot token (from Slack App settings)
# SLACK_MCP_XOXP_TOKEN=xoxp-...  # User token (for search — optional)

# ══════════════════════════════════════════════════════════════════════════════
# MCP SERVERS — Phase 4 (BigQuery + CRM)
# ══════════════════════════════════════════════════════════════════════════════

# ── BigQuery MCP ──────────────────────────────────────────────────────────────
# Covers: execute SQL, list tables, describe schemas
# BIGQUERY_MCP_URL=http://localhost:8002/mcp
# BIGQUERY_PROJECT_ID=your-gcp-project

# ── Notion MCP (if your company uses Notion) ─────────────────────────────────
# NOTION_MCP_URL=http://localhost:8003/mcp
# NOTION_API_KEY=secret_...

# ── HubSpot MCP (CRM — Phase 4-5) ────────────────────────────────────────────
# HUBSPOT_MCP_URL=http://localhost:8004/mcp
# HUBSPOT_API_KEY=pat-...

# ══════════════════════════════════════════════════════════════════════════════
# OPTIONAL SERVICES
# ══════════════════════════════════════════════════════════════════════════════

# ── Email transactionnel — Resend ────────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...
RESEND_FROM=CorpMind AI <noreply@music.zinakonect.com>

# ── SMTP (legacy fallback) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── ElevenLabs (text-to-speech) ───────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ══════════════════════════════════════════════════════════════════════════════
# INTÉGRATIONS MARKETING & COMMUNICATION (Phase Vidéo + Social + WhatsApp)
# ══════════════════════════════════════════════════════════════════════════════

# ── Pipeline Vidéo AI ─────────────────────────────────────────────────────────
# Kling 2.1 (standard, $0.70/10s) via PiAPI
KLING_API_KEY=          # ou PIAPI_API_KEY (même clé)
PIAPI_API_KEY=          # https://piapi.ai → API Keys

# Wan 2.2 (budget, $0.21/10s) via SiliconFlow
SILICONFLOW_API_KEY=    # https://siliconflow.cn → API Keys

# Veo 3 (premium, $3.00/10s) — utilise GOOGLE_AI_API_KEY ci-dessus
# Assurez-vous que votre projet GCP a accès au modèle veo-3.0-generate-preview

# ── WhatsApp Business (Meta Cloud API) ───────────────────────────────────────
# Récupérez depuis Meta for Developers → WhatsApp → API Setup
WHATSAPP_APP_SECRET=    # App Secret (pour vérification X-Hub-Signature-256)
# Les tokens par entreprise sont stockés chiffrés dans Firestore (via /api/whatsapp/connect)

# ── Réseaux Sociaux (tokens stockés par entreprise dans Firestore) ────────────
# Clé de chiffrement AES-256 pour les tokens OAuth (32 caractères minimum)
SOCIAL_ENCRYPTION_KEY=corpmind-social-key-32byteslong!!  # À CHANGER EN PRODUCTION

# ── Stripe (facturation) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ── BYOE Tenant Encryption ───────────────────────────────────────────────────
TENANT_ENCRYPTION_KEY=  # 32+ caractères, requis pour Business/Enterprise BYOE

1a043dae0b994b15ed843c5477e8384c