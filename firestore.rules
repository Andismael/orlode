rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getCompanyId() {
      return getUserData().companyId;
    }

    function belongsToCompany(companyId) {
      return isAuthenticated() && getCompanyId() == companyId;
    }

    function isCompanyAdmin(companyId) {
      return belongsToCompany(companyId) && getUserData().role in ['admin', 'manager'];
    }

    function isCompanyOwner(companyId) {
      return belongsToCompany(companyId) && getUserData().role == 'admin';
    }

    // ── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isUser(userId) || belongsToCompany(resource.data.companyId)
      );
      allow write:  if isUser(userId);
      allow create: if isAuthenticated();
      // Admins can update user roles
      allow update: if isAuthenticated() && isCompanyAdmin(resource.data.companyId);
    }

    // ── Companies ───────────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read:   if belongsToCompany(companyId);
      allow create: if isAuthenticated() && request.auth.uid == companyId;
      allow update: if isCompanyAdmin(companyId);
      allow delete: if false; // Never delete via client

      // ── Documents ──────────────────────────────────────────────────────
      match /documents/{documentId} {
        allow read:   if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId);
        allow update: if belongsToCompany(companyId);
        allow delete: if isCompanyAdmin(companyId);
      }

      // ── Vector chunks (embeddings — read-only for clients) ──────────────
      match /vectorChunks/{chunkId} {
        allow read:  if belongsToCompany(companyId);
        allow write: if false; // Server-only
      }

      // ── Meetings ────────────────────────────────────────────────────────
      match /meetings/{meetingId} {
        allow read:   if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId);
        allow update: if belongsToCompany(companyId);
        allow delete: if isCompanyAdmin(companyId);
      }

      // ── Faces / biometric ────────────────────────────────────────────────
      match /faces/{faceId} {
        allow read:   if belongsToCompany(companyId);
        allow create: if isCompanyAdmin(companyId);
        allow update: if isCompanyAdmin(companyId);
        allow delete: if isCompanyAdmin(companyId);
      }

      // ── IT Assets ───────────────────────────────────────────────────────
      match /itAssets/{assetId} {
        allow read:   if belongsToCompany(companyId);
        allow write:  if isCompanyAdmin(companyId);
      }

      match /itTickets/{ticketId} {
        allow read:   if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId);
        allow update: if isCompanyAdmin(companyId);
        allow delete: if false;
      }

      // ── Security ─────────────────────────────────────────────────────────
      match /securityIncidents/{incidentId} {
        allow read:   if isCompanyAdmin(companyId);
        allow create: if belongsToCompany(companyId);
        allow update: if isCompanyAdmin(companyId);
        allow delete: if false;
      }

      match /securityScore/{scoreId} {
        allow read:  if isCompanyAdmin(companyId);
        allow write: if false; // Server-only
      }

      // ── Marketing content ─────────────────────────────────────────────────
      match /marketingContent/{contentId} {
        allow read:   if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId);
        allow update: if isCompanyAdmin(companyId);
        allow delete: if isCompanyAdmin(companyId);
      }

      // ── HR ───────────────────────────────────────────────────────────────
      match /leaveRequests/{requestId} {
        allow read: if belongsToCompany(companyId) && (
          resource.data.userId == request.auth.uid || isCompanyAdmin(companyId)
        );
        allow create: if belongsToCompany(companyId);
        allow update: if isCompanyAdmin(companyId);
        allow delete: if false;
      }

      match /leaveBalances/{balanceId} {
        allow read: if belongsToCompany(companyId) && (
          balanceId.matches(request.auth.uid + '_.*') || isCompanyAdmin(companyId)
        );
        allow write: if false; // Server-only
      }

      match /hrPolicies/{policyId} {
        allow read:  if belongsToCompany(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      // ── Finance ──────────────────────────────────────────────────────────
      match /invoices/{invoiceId} {
        allow read:  if isCompanyAdmin(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      match /expenses/{expenseId} {
        allow read: if belongsToCompany(companyId) && (
          resource.data.submittedBy == request.auth.uid || isCompanyAdmin(companyId)
        );
        allow create: if belongsToCompany(companyId);
        allow update: if isCompanyAdmin(companyId);
        allow delete: if false;
      }

      // ── Sales ────────────────────────────────────────────────────────────
      match /leads/{leadId} {
        allow read:  if belongsToCompany(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      match /deals/{dealId} {
        allow read:  if belongsToCompany(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      // ── Support ──────────────────────────────────────────────────────────
      match /supportTickets/{ticketId} {
        allow read:   if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId);
        allow update: if isCompanyAdmin(companyId);
        allow delete: if false;
      }

      // ── Legal ────────────────────────────────────────────────────────────
      match /legalDeadlines/{deadlineId} {
        allow read:  if isCompanyAdmin(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      match /contractTemplates/{templateId} {
        allow read:  if belongsToCompany(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      // ── Training ─────────────────────────────────────────────────────────
      match /trainingCourses/{courseId} {
        allow read:  if belongsToCompany(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      match /trainingProgress/{progressId} {
        allow read: if belongsToCompany(companyId);
        allow write: if belongsToCompany(companyId);
      }

      // ── News ─────────────────────────────────────────────────────────────
      match /newsBriefings/{briefingId} {
        allow read:  if belongsToCompany(companyId);
        allow write: if false; // Server-only
      }

      // ── API Keys (admin only — no plaintext keys stored) ─────────────────
      match /apiKeys/{keyId} {
        allow read:  if isCompanyAdmin(companyId);
        allow write: if false; // Server-only
      }

      // ── Billing / Usage ───────────────────────────────────────────────────
      match /usageMetrics/{month} {
        allow read:  if isCompanyAdmin(companyId);
        allow write: if false; // Server-only
      }

      // ── Settings ──────────────────────────────────────────────────────────
      match /settings/{settingId} {
        allow read:  if belongsToCompany(companyId);
        allow write: if isCompanyAdmin(companyId);
      }

      // ── Visitors (Reception) ──────────────────────────────────────────────
      match /visitors/{visitId} {
        allow read:  if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId);
        allow update: if isCompanyAdmin(companyId);
        allow delete: if false;
      }

      // ── Compliance ────────────────────────────────────────────────────────
      match /compliance/{frameworkId} {
        allow read:  if isCompanyAdmin(companyId);
        allow write: if false; // Server-only
      }

      // ── Commerce / Boutique WhatsApp ──────────────────────────────────────
      // Stores belong to a company. Admins manage them; team members can read.
      match /stores/{storeId} {
        allow read:  if belongsToCompany(companyId);
        allow create: if isCompanyAdmin(companyId);
        allow update: if isCompanyAdmin(companyId);
        allow delete: if false; // Never delete via client (audit + orders linked)

        match /products/{productId} {
          allow read:   if belongsToCompany(companyId);
          allow create: if belongsToCompany(companyId);
          allow update: if belongsToCompany(companyId);
          allow delete: if isCompanyAdmin(companyId);
        }

        match /orders/{orderId} {
          allow read:   if belongsToCompany(companyId);
          allow create: if belongsToCompany(companyId);
          allow update: if isCompanyAdmin(companyId);
          allow delete: if false; // Orders are append-only for audit
        }

        // Sessions hold OTP hashes — never readable from client.
        // Server-only via Admin SDK.
        match /sessions/{sessionId} {
          allow read:  if false;
          allow write: if false;
        }
      }

      // Catch-all for any other company subcollections — admin read/write
      match /{subcollection}/{docId} {
        allow read:  if belongsToCompany(companyId);
        allow write: if isCompanyAdmin(companyId);
      }
    }

    // ── Conversations ─────────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        belongsToCompany(resource.data.companyId)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isCompanyAdmin(resource.data.companyId)
      );

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid ||
          belongsToCompany(get(/databases/$(database)/documents/conversations/$(conversationId)).data.companyId)
        );
        allow write: if isAuthenticated();
      }
    }

    // ── Audit Logs (company admin read-only, server write-only) ──────────────
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isCompanyAdmin(resource.data.companyId)
      );
      allow write: if false; // Server-only via Admin SDK
    }

    // ── Insights (company-level) ──────────────────────────────────────────────
    match /insights/{insightId} {
      allow read: if isAuthenticated() && belongsToCompany(resource.data.companyId);
      allow write: if false; // Server-only
    }

    // ── Talents conversations (recruiter ↔ candidate inbox) ────────────────
    // Only the recruiter who initiated the conversation can read it. Writes
    // happen server-side via the API routes (auth + ownership check).
    match /talent_conversations/{convId} {
      allow read: if isAuthenticated() && resource.data.recruiterUid == request.auth.uid;
      allow write: if false;
      match /messages/{messageId} {
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/talent_conversations/$(convId)).data.recruiterUid == request.auth.uid;
        allow write: if false;
      }
    }
    // Audit log — recruiter sees their own sent contacts (analytics).
    match /talent_contacts/{contactId} {
      allow read: if isAuthenticated() && resource.data.recruiterUid == request.auth.uid;
      allow write: if false;
    }

    // ── Orlode Influenceurs (public marketplace, brand ↔ creator) ──────────
    // Same pattern as Talents — public read on active profiles, owner-only
    // write. Verifications and admin actions go through server-side
    // Cloud Functions only (not enforced here yet, write locked).
    match /influencers_profiles/{influencerId} {
      allow read: if resource.data.status == 'active';
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      match /private/{docId} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/influencers_profiles/$(influencerId)).data.userId == request.auth.uid;
      }
    }

    // ── Orlode Talents (public marketplace, same Firebase as Orlode) ────────
    // The talents_profiles collection is read-only-public for active candidates.
    // Recruiters (and the orlode.com /talents feed) need to discover talents
    // without auth. WRITES happen via the standalone talents-app at
    // talents.orlode.com under the candidate's own auth session (Phase 2 —
    // not enforced here yet; until then the create/update path is locked
    // server-side via Cloud Functions only).
    match /talents_profiles/{talentId} {
      allow read: if resource.data.status == 'active';
      // Owner can manage their own profile (matches the talents-app auth flow).
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Private subcollection: whatsapp number, contact details — owner only.
      match /private/{docId} {
        allow read, write: if isAuthenticated() && get(/databases/$(database)/documents/talents_profiles/$(talentId)).data.userId == request.auth.uid;
      }
    }
  }
}
