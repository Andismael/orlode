{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "outDir": "lib",
    "sourceMap": true,
    "strict": false,
    "target": "es2020",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "baseUrl": ".",
    "paths": {
      "../../server/src/*": ["../server/src/*"]
    }
  },
  "include": ["src", "../server/src/**/*"],
  "exclude": [
    "node_modules",
    "lib",
    "../server/node_modules",
    "../server/src/__tests__/**/*"
  ]
}
